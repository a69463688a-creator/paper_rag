# ========================================
# 配置文件模板
# 复制为 config.ini 并填入真实凭据
# cp config.ini.example config.ini
# ========================================

# MySQL 配置
[mysql]
host = localhost
user = root
password = 请替换为你的MySQL密码
database = subjects_kg

# Redis 配置
[redis]
host = localhost
port = 6379
password = 请替换为你的Redis密码
db = 0

# 日志配置
[logger]
log_file = logs/app.log

# Milvus 配置
[milvus]
host = localhost
port = 19530
database_name = itcast
collection_name = edurag_final


# LLM 配置
[llm]
model = deepseek-chat
dashscope_api_key = 请替换为你的API Key
dashscope_base_url = https://api.deepseek.com

# 检索参数配置
[retrieval]
parent_chunk_size = 1200
child_chunk_size = 300
chunk_overlap = 50
retrieval_k = 3
candidate_m = 2

# 应用配置
[app]
valid_sources = ["ai", "java", "test", "ops", "bigdata"]
customer_service_phone = 12345678
