# PaperRAG 环境变量配置模板
# 复制此文件为 .env 并填入真实值

# DeepSeek API Key (必填)
DASHSCOPE_API_KEY=sk-your-deepseek-api-key

# DeepSeek Base URL
DASHSCOPE_BASE_URL=https://api.deepseek.com

# MySQL
MYSQL_HOST=localhost
MYSQL_USER=root
MYSQL_PASSWORD=your_mysql_password
MYSQL_DATABASE=paper_rag

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=your_redis_password
REDIS_CACHE_TTL=3600

# Milvus
MILVUS_HOST=localhost
MILVUS_PORT=19530
